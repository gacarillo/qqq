{
  "name": "gfetsim-estudio",
  "version": "1.0.0",
  "private": true,
  "description": "Estúdio de simulação do GFET de porta local, com os modelos do gfetsim rodando no navegador",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:rapido": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "verificar": "npm run typecheck && npm run lint && npm run test",
    "dados": "python3 scripts/exportar_params.py && python3 scripts/exportar_referencias.py"
  },
  "devDependencies": {
    "@eslint/js": "9.28.0",
    "@types/node": "^22.15.30",
    "@types/three": "0.170.0",
    "eslint": "9.28.0",
    "jsdom": "26.1.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.33.1",
    "vite": "6.3.5",
    "vite-plugin-singlefile": "2.2.0",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "three": "0.170.0"
  }
}
