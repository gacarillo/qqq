{
  "name": "feira-sort",
  "private": true,
  "version": "0.1.0",
  "description": "Sort puzzle por fases com álbum de figurinhas (protótipo web)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fases": "tsx ferramentas/montar-fases.ts",
    "fases:ver": "tsx ferramentas/ver-fases.ts",
    "pagina": "npm run build && tsx ferramentas/pagina-publicavel.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.1.1"
  }
}
